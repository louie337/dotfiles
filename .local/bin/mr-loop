#!/bin/sh

set -u

PROGRAM=${0##*/}
POLL_INTERVAL=${MR_LOOP_POLL_INTERVAL:-30}
MAX_REPAIRS=${MR_LOOP_MAX_REPAIRS:-12}
MAX_RUNTIME=${MR_LOOP_MAX_RUNTIME:-14400}
MAX_LOG_LINES=${MR_LOOP_MAX_LOG_LINES:-400}
NETWORK_RETRIES=${MR_LOOP_NETWORK_RETRIES:-3}
COMMAND_TIMEOUT=${MR_LOOP_COMMAND_TIMEOUT:-120}
AGENT_TIMEOUT=${MR_LOOP_AGENT_TIMEOUT:-1800}
STATE_CHANGE_TIMEOUT=${MR_LOOP_STATE_CHANGE_TIMEOUT:-600}
ON_SUCCESS=notify
MR_URL=
MR_HOST=
MR_PROJECT=
MR_IID=
MR_PROJECT_ENCODED=
REPO_ROOT=
LOCK_DIR=
REPAIRS=0
LAST_MR_SHA=
LAST_PIPELINE_SHA=
LAST_PIPELINE_STATUS=unknown
LAST_MERGE_STATUS=unknown
LAST_FAILED_JOBS=
STOP_REASON=
EXPECTED_LOCAL_SHA=
CONTEXT_FILE=
TRACE_FILE=
DISCUSSION_CONTEXT_FILE=
DISCUSSION_RESULT_FILE=
DISCUSSION_DISPOSITION=
DISCUSSION_REPLY=

usage() {
  printf 'Usage: %s <MR URL> [--on-success notify|merge]\n' "$PROGRAM" >&2
}

parse_mr_url() {
  url=$1
  parsed=$(printf '%s\n' "$url" | sed -n 's#^https://\([^/]*\)/\(.*/[^/]*\)/-/merge_requests/\([0-9][0-9]*\)/*$#\1|\2|\3#p')
  [ -n "$parsed" ] || return 1
  MR_HOST=${parsed%%|*}
  rest=${parsed#*|}
  MR_PROJECT=${rest%|*}
  MR_IID=${rest##*|}
  MR_PROJECT_ENCODED=$(printf '%s' "$MR_PROJECT" | jq -sRr @uri)
}

parse_args() {
  ON_SUCCESS=notify
  MR_URL=
  [ "$#" -ge 1 ] || {
    usage
    return 2
  }
  MR_URL=$1
  shift
  parse_mr_url "$MR_URL" || {
    printf 'Invalid GitLab merge request URL: %s\n' "$MR_URL" >&2
    return 2
  }
  while [ "$#" -gt 0 ]; do
    case $1 in
      --on-success)
        [ "$#" -ge 2 ] || {
          usage
          return 2
        }
        ON_SUCCESS=$2
        shift 2
        ;;
      *)
        printf 'Unknown argument: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  case $ON_SUCCESS in
    notify|merge) ;;
    *)
      printf 'Invalid success action: %s\n' "$ON_SUCCESS" >&2
      return 2
      ;;
  esac
}

pipeline_for_sha() {
  sha=$1
  jq -c --arg sha "$sha" '[.[] | select(.sha == $sha)] | sort_by(.id) | last // null'
}

pipeline_action() {
  case $1 in
    created|waiting_for_resource|preparing|pending|running|scheduled) printf 'wait\n' ;;
    success) printf 'check-merge\n' ;;
    failed|canceled) printf 'repair\n' ;;
    *) printf 'stop\n' ;;
  esac
}

merge_status_action() {
  case $1 in
    mergeable) printf 'ready\n' ;;
    checking|preparing|approvals_syncing|unchecked) printf 'wait\n' ;;
    *) printf 'stop\n' ;;
  esac
}

rebase_action() {
  printf '%s' "$1" | jq -r '
    if (.merge_error // null) != null then "error"
    elif (.rebase_in_progress // false) then "wait"
    elif (.diverged_commits_count // 0) > 0 then "request"
    else "ready"
    end
  '
}

mr_is_mergeable() {
  mr_json=$1
  expected_sha=$2
  printf '%s' "$mr_json" | jq -e --arg sha "$expected_sha" '
    .sha == $sha and
    .has_conflicts == false and
    .detailed_merge_status == "mergeable" and
    .blocking_discussions_resolved == true and
    .approved == true
  ' >/dev/null
}

repair_allowed() {
  [ "$1" -lt "$2" ]
}

mr_matches_expected() {
  mr_json=$1
  expected_sha=$2
  expected_branch=$3
  expected_project_id=$4
  printf '%s' "$mr_json" | jq -e \
    --arg sha "$expected_sha" \
    --arg branch "$expected_branch" \
    --argjson project_id "$expected_project_id" '
      .state == "opened" and
      .sha == $sha and
      .source_branch == $branch and
      .source_project_id == $project_id and
      .target_project_id == $project_id
    ' >/dev/null
}

run_with_timeout() {
  seconds=$1
  shift
  perl -e 'setpgrp(0, 0); exec @ARGV' -- "$@" &
  command_pid=$!
  timeout_marker="${TMPDIR:-/tmp}/mr-loop-timeout.$$.$command_pid"
  rm -f "$timeout_marker"
  perl -e '
    my ($seconds, $marker, $pgid) = @ARGV;
    sleep $seconds;
    open my $fh, ">", $marker or exit 1;
    close $fh;
    kill "TERM", -$pgid;
    sleep 2;
    kill "KILL", -$pgid;
  ' "$seconds" "$timeout_marker" "$command_pid" &
  timer_pid=$!
  wait "$command_pid"
  status=$?
  kill "$timer_pid" 2>/dev/null || true
  wait "$timer_pid" 2>/dev/null || true
  if [ -f "$timeout_marker" ]; then
    rm -f "$timeout_marker"
    return 142
  fi
  return "$status"
}

redact_log() {
  sed -E \
    -e 's/((token|password|secret)[=:])[[:space:]]*[^[:space:]]+/\1[REDACTED]/Ig' \
    -e 's/(Authorization:[[:space:]]*Bearer)[[:space:]]+[^[:space:]]+/\1 [REDACTED]/Ig' \
    -e 's/(PRIVATE-TOKEN:)[[:space:]]*[^[:space:]]+/\1 [REDACTED]/Ig'
}

log() {
  printf '[mr-loop] %s\n' "$*"
}

die() {
  STOP_REASON=$1
  printf '[mr-loop] ERROR: %s\n' "$STOP_REASON" >&2
  exit 1
}

require_commands() {
  missing=
  for command_name in git glab jq opencode perl sed tail; do
    command -v "$command_name" >/dev/null 2>&1 || missing="$missing $command_name"
  done
  [ -z "$missing" ] || die "Missing required commands:$missing"
}

retry() {
  attempt=1
  while ! "$@"; do
    [ "$attempt" -lt "$NETWORK_RETRIES" ] || return 1
    attempt=$((attempt + 1))
    sleep 2
  done
}

api() {
  retry run_with_timeout "$COMMAND_TIMEOUT" glab api --hostname "$MR_HOST" "$@"
}

fetch_mr() {
  mr=$(api "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID?include_rebase_in_progress=true&include_diverged_commits_count=true") || return 1
  approvals=$(api "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/approvals") || return 1
  printf '%s\n%s\n' "$mr" "$approvals" | jq -s '
    .[0] + {
      approved: (.[1].approved == true or (.[1].approvals_left // 1) == 0)
    }
  '
}

fetch_discussions() {
  discussion_pages=$(api --paginate \
    "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/discussions?per_page=100") || return 1
  printf '%s\n' "$discussion_pages" | jq -s 'add // []'
}

fetch_discussion() {
  api "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/discussions/$1"
}

fetch_pipelines() {
  api "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/pipelines?per_page=100"
}

next_unresolved_discussion() {
  jq -c '
    [.[] | select(any(.notes[]; .resolvable == true and .resolved == false))]
    | sort_by([.notes[] | select(.resolvable == true and .resolved == false) | .created_at] | min)
    | first // null
  '
}

discussion_is_unresolved() {
  expected_id=$1
  jq -e --arg id "$expected_id" '
    .id == $id and any(.notes[]; .resolvable == true and .resolved == false)
  ' >/dev/null
}

reply_and_resolve_discussion() {
  discussion_id=$1
  reply=$2
  expected_sha=$3
  latest_mr=$(fetch_mr) || return 1
  [ "$(printf '%s' "$latest_mr" | jq -r .sha)" = "$expected_sha" ] || return 1
  latest_discussion=$(fetch_discussion "$discussion_id") || return 1
  printf '%s' "$latest_discussion" | discussion_is_unresolved "$discussion_id" || return 1
  api --method POST --field "body=$reply" \
    "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/discussions/$discussion_id/notes" >/dev/null || return 1
  api --method PUT --field resolved=true \
    "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/discussions/$discussion_id" >/dev/null
}

fetch_failed_logs() {
  pipeline_id=$1
  jobs_file=$(mktemp "${TMPDIR:-/tmp}/mr-loop-jobs.XXXXXX") || return 1
  if ! collect_failed_jobs "$pipeline_id" >"$jobs_file" || [ ! -s "$jobs_file" ]; then
    rm -f "$jobs_file"
    return 1
  fi
  LAST_FAILED_JOBS=$(cut -f2 "$jobs_file" | paste -sd ', ' -)
  while IFS="$(printf '\t')" read -r job_id job_name; do
    printf '\n===== FAILED JOB: %s (id %s) =====\n' "$job_name" "$job_id"
    fetch_job_trace "$job_id" || {
      rm -f "$jobs_file"
      return 1
    }
  done <"$jobs_file"
  rm -f "$jobs_file"
}

collect_failed_jobs() {
  pipeline_id=$1
  depth=${2:-0}
  [ "$depth" -lt 5 ] || return 1
  jobs=$(api "projects/$MR_PROJECT_ENCODED/pipelines/$pipeline_id/jobs?scope[]=failed&per_page=100") || return 1
  printf '%s' "$jobs" | jq -r '.[] | [.id, .name] | @tsv'
  bridges=$(api "projects/$MR_PROJECT_ENCODED/pipelines/$pipeline_id/bridges?per_page=100") || return 1
  downstream_ids=$(printf '%s' "$bridges" | jq -r '.[] | select(.status == "failed" or .status == "canceled") | .downstream_pipeline.id // empty')
  for downstream_id in $downstream_ids; do
    collect_failed_jobs "$downstream_id" "$((depth + 1))" || return 1
  done
}

fetch_job_trace() {
  job_id=$1
  TRACE_FILE=$(mktemp "${TMPDIR:-/tmp}/mr-loop-trace.XXXXXX") || return 1
  if ! api "projects/$MR_PROJECT_ENCODED/jobs/$job_id/trace" >"$TRACE_FILE"; then
    rm -f "$TRACE_FILE"
    TRACE_FILE=
    return 1
  fi
  tail -n "$MAX_LOG_LINES" "$TRACE_FILE" | redact_log
  status=$?
  rm -f "$TRACE_FILE"
  TRACE_FILE=
  return "$status"
}

remote_project_url() {
  git remote get-url origin | sed -E \
    -e 's#^git@([^:]+):#https://\1/#' \
    -e 's#^ssh://git@([^/]+)/#https://\1/#' \
    -e 's#\.git$##'
}

validate_repository() {
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  remote_url=$(remote_project_url) || return 1
  expected="https://$MR_HOST/$MR_PROJECT"
  [ "$remote_url" = "$expected" ] || die "MR project $expected does not match origin $remote_url"
  [ -z "$(git status --porcelain --untracked-files=normal)" ] || die "Working tree must be clean, including untracked files"
}

auth_check() {
  run_with_timeout "$COMMAND_TIMEOUT" glab auth status --hostname "$MR_HOST" >/dev/null 2>&1 || die "glab is not authenticated for $MR_HOST"
}

acquire_lock() {
  LOCK_DIR=$(git rev-parse --git-path mr-loop.lock)
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" >"$LOCK_DIR/pid"
    printf '%s\n' "$MR_URL" >"$LOCK_DIR/mr-url"
    return 0
  fi
  lock_pid=$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)
  if [ -n "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
    stale_lock="$LOCK_DIR.stale.$$"
    if mv "$LOCK_DIR" "$stale_lock" 2>/dev/null; then
      rm -rf "$stale_lock"
      acquire_lock
      return $?
    fi
  fi
  die "Another MR repair loop holds $LOCK_DIR"
}

release_lock() {
  [ -n "$LOCK_DIR" ] && [ -d "$LOCK_DIR" ] || return 0
  lock_pid=$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)
  [ "$lock_pid" = "$$" ] && rm -rf "$LOCK_DIR"
}

cleanup() {
  [ -z "$CONTEXT_FILE" ] || rm -f "$CONTEXT_FILE"
  [ -z "$TRACE_FILE" ] || rm -f "$TRACE_FILE"
  [ -z "$DISCUSSION_CONTEXT_FILE" ] || rm -f "$DISCUSSION_CONTEXT_FILE"
  [ -z "$DISCUSSION_RESULT_FILE" ] || rm -f "$DISCUSSION_RESULT_FILE"
  CONTEXT_FILE=
  TRACE_FILE=
  DISCUSSION_CONTEXT_FILE=
  DISCUSSION_RESULT_FILE=
  release_lock
}

local_head_relation() {
  mr_sha=$1
  local_sha=$2
  if [ "$mr_sha" = "$local_sha" ]; then
    printf 'equal\n'
  elif git -C "$REPO_ROOT" merge-base --is-ancestor "$mr_sha" "$local_sha"; then
    printf 'ahead\n'
  elif git -C "$REPO_ROOT" merge-base --is-ancestor "$local_sha" "$mr_sha"; then
    printf 'behind\n'
  else
    printf 'diverged\n'
  fi
}

wait_for_mr_sha() {
  expected_sha=$1
  deadline=$(($(date +%s) + STATE_CHANGE_TIMEOUT))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    current_mr=$(fetch_mr) || return 1
    [ "$(printf '%s' "$current_mr" | jq -r .state)" = opened ] || return 1
    if [ "$(printf '%s' "$current_mr" | jq -r .sha)" = "$expected_sha" ]; then
      return 0
    fi
    sleep "$POLL_INTERVAL"
  done
  return 1
}

sync_local_descendant() {
  source_branch=$1
  remote_sha=$2
  project_id=$3
  local_sha=$(git -C "$REPO_ROOT" rev-parse HEAD) || return 1
  [ "$(local_head_relation "$remote_sha" "$local_sha")" = ahead ] || return 1
  latest_mr=$(fetch_mr) || return 1
  mr_matches_expected "$latest_mr" "$remote_sha" "$source_branch" "$project_id" || return 1
  run_with_timeout "$COMMAND_TIMEOUT" git -C "$REPO_ROOT" push origin "HEAD:$source_branch" || return 1
  wait_for_mr_sha "$local_sha" || return 1
  EXPECTED_LOCAL_SHA=$local_sha
}

align_after_gitlab_rebase() {
  source_branch=$1
  old_sha=$2
  new_sha=$3
  [ -z "$(git status --porcelain --untracked-files=normal)" ] || return 1
  [ "$(git branch --show-current)" = "$source_branch" ] || return 1
  [ "$(git rev-parse HEAD)" = "$old_sha" ] || return 1
  retry run_with_timeout "$COMMAND_TIMEOUT" git fetch origin "$source_branch" || return 1
  [ "$(git rev-parse FETCH_HEAD)" = "$new_sha" ] || return 1
  git switch --detach "$new_sha" >/dev/null || return 1
  git branch -f "$source_branch" "$new_sha" >/dev/null || return 1
  git switch "$source_branch" >/dev/null || return 1
  EXPECTED_LOCAL_SHA=$new_sha
}

wait_for_gitlab_rebase() {
  expected_sha=$1
  source_branch=$2
  deadline=$(($(date +%s) + STATE_CHANGE_TIMEOUT))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    latest_mr=$(fetch_mr) || return 1
    [ "$(printf '%s' "$latest_mr" | jq -r '.merge_error // empty')" = "" ] || return 1
    if [ "$(printf '%s' "$latest_mr" | jq -r '.rebase_in_progress // false')" = false ]; then
      new_sha=$(printf '%s' "$latest_mr" | jq -r .sha)
      if [ "$new_sha" != "$expected_sha" ]; then
        align_after_gitlab_rebase "$source_branch" "$expected_sha" "$new_sha"
        return $?
      fi
    fi
    sleep "$POLL_INTERVAL"
  done
  return 1
}

request_gitlab_rebase() {
  expected_sha=$1
  source_branch=$2
  project_id=$3
  latest_mr=$(fetch_mr) || return 1
  mr_matches_expected "$latest_mr" "$expected_sha" "$source_branch" "$project_id" || return 1
  api --method PUT "projects/$MR_PROJECT_ENCODED/merge_requests/$MR_IID/rebase" >/dev/null || return 1
  wait_for_gitlab_rebase "$expected_sha" "$source_branch"
}

checkout_mr_branch() {
  mr_json=$1
  source_project_id=$(printf '%s' "$mr_json" | jq -r .source_project_id)
  target_project_id=$(printf '%s' "$mr_json" | jq -r .target_project_id)
  [ "$source_project_id" = "$target_project_id" ] || die "Fork merge requests are not supported"
  source_branch=$(printf '%s' "$mr_json" | jq -r .source_branch)
  remote_sha=$(printf '%s' "$mr_json" | jq -r .sha)
  retry run_with_timeout "$COMMAND_TIMEOUT" git fetch origin "$source_branch" || die "Unable to fetch MR source branch"
  if git show-ref --verify --quiet "refs/heads/$source_branch"; then
    git switch "$source_branch" >/dev/null || die "Unable to switch to $source_branch"
  else
    git switch --track -c "$source_branch" "origin/$source_branch" >/dev/null || die "Unable to create $source_branch"
  fi
  local_sha=$(git rev-parse HEAD)
  case $(local_head_relation "$remote_sha" "$local_sha") in
    equal) ;;
    ahead)
      sync_local_descendant "$source_branch" "$remote_sha" "$target_project_id" || \
        die "Unable to push local descendant commits or converge MR state"
      ;;
    behind) die "Local branch is behind MR SHA $remote_sha" ;;
    diverged) die "Local branch diverges from MR SHA $remote_sha" ;;
  esac
  EXPECTED_LOCAL_SHA=$(git -C "$REPO_ROOT" rev-parse HEAD)
}

assert_unchanged_head() {
  expected_branch=$1
  expected_sha=$2
  [ "$(git branch --show-current)" = "$expected_branch" ] && [ "$(git rev-parse HEAD)" = "$expected_sha" ]
}

run_repair_agent() {
  mr_json=$1
  pipeline_json=$2
  CONTEXT_FILE=$(mktemp "${TMPDIR:-/tmp}/mr-loop-context.XXXXXX") || return 1
  pipeline_id=$(printf '%s' "$pipeline_json" | jq -r .id)
  {
    printf '# GitLab MR repair context\n\n'
    printf 'MR: %s\n' "$MR_URL"
    printf 'MR SHA: %s\n' "$LAST_MR_SHA"
    printf 'Pipeline: %s\n' "$(printf '%s' "$pipeline_json" | jq -r .web_url)"
    printf 'Repair attempt: %s of %s\n' "$((REPAIRS + 1))" "$MAX_REPAIRS"
    fetch_failed_logs "$pipeline_id"
  } >"$CONTEXT_FILE" || {
    rm -f "$CONTEXT_FILE"
    CONTEXT_FILE=
    return 1
  }
  run_with_timeout "$AGENT_TIMEOUT" opencode run \
    "Diagnose the attached failed jobs, make the smallest correct repair, recommend focused verification commands, and leave all changes uncommitted." \
    --agent mr-repair --dir "$REPO_ROOT" --file "$CONTEXT_FILE"
  status=$?
  rm -f "$CONTEXT_FILE"
  CONTEXT_FILE=
  return "$status"
}

parse_discussion_result() {
  [ -f "$DISCUSSION_RESULT_FILE" ] || return 1
  jq -e '
    (keys | sort) == ["disposition", "reply"] and
    (.disposition | IN("fixed", "invalid", "obsolete", "blocked")) and
    (.reply | type == "string" and length > 0)
  ' "$DISCUSSION_RESULT_FILE" >/dev/null || return 1
  DISCUSSION_DISPOSITION=$(jq -r .disposition "$DISCUSSION_RESULT_FILE")
  DISCUSSION_REPLY=$(jq -r .reply "$DISCUSSION_RESULT_FILE")
}

run_discussion_agent() {
  mr_json=$1
  discussion_json=$2
  DISCUSSION_CONTEXT_FILE=$(mktemp "${TMPDIR:-/tmp}/mr-loop-discussion.XXXXXX") || return 1
  DISCUSSION_RESULT_FILE="$REPO_ROOT/.mr-loop-discussion-result.json"
  rm -f "$DISCUSSION_RESULT_FILE"
  if ! {
    printf '# GitLab MR discussion repair context\n\n'
    printf 'MR: %s\n' "$MR_URL"
    printf 'MR SHA: %s\n' "$(printf '%s' "$mr_json" | jq -r .sha)"
    printf 'Generated repair attempt: %s of %s\n\n' "$((REPAIRS + 1))" "$MAX_REPAIRS"
    printf '## Discussion JSON\n\n```json\n%s\n```\n' "$discussion_json"
  } >"$DISCUSSION_CONTEXT_FILE"; then
    status=1
  elif ! run_with_timeout "$AGENT_TIMEOUT" opencode run \
    "Evaluate the attached discussion, repair it if valid, and write the required result file." \
    --agent mr-discussion-repair --dir "$REPO_ROOT" --file "$DISCUSSION_CONTEXT_FILE"; then
    status=1
  elif ! parse_discussion_result; then
    status=1
  else
    status=0
  fi
  rm -f "$DISCUSSION_RESULT_FILE" "$DISCUSSION_CONTEXT_FILE"
  DISCUSSION_RESULT_FILE=
  DISCUSSION_CONTEXT_FILE=
  return "$status"
}

commit_generated_repair() {
  source_branch=$1
  expected_sha=$2
  project_id=$3
  message=$4
  repair_allowed "$REPAIRS" "$MAX_REPAIRS" || return 1
  [ -n "$(git status --porcelain --untracked-files=normal)" ] || return 1
  latest_mr=$(fetch_mr) || return 1
  mr_matches_expected "$latest_mr" "$expected_sha" "$source_branch" "$project_id" || return 1
  git add --all || return 1
  git commit -m "$message" || return 1
  new_sha=$(git rev-parse HEAD) || return 1
  latest_mr=$(fetch_mr) || return 1
  mr_matches_expected "$latest_mr" "$expected_sha" "$source_branch" "$project_id" || return 1
  run_with_timeout "$COMMAND_TIMEOUT" git push origin "HEAD:$source_branch" || return 1
  wait_for_mr_sha "$new_sha" || return 1
  REPAIRS=$((REPAIRS + 1))
  LAST_MR_SHA=$new_sha
  EXPECTED_LOCAL_SHA=$new_sha
}

commit_and_push() {
  source_branch=$1
  expected_sha=$2
  project_id=$3
  commit_generated_repair "$source_branch" "$expected_sha" "$project_id" \
    "fix(ci): repair failed pipeline" || die "Unable to commit, push, or converge repair"
}

process_discussion() {
  mr_json=$1
  discussion_json=$2
  source_branch=$3
  project_id=$4
  expected_sha=$(printf '%s' "$mr_json" | jq -r .sha)
  discussion_id=$(printf '%s' "$discussion_json" | jq -r .id)
  run_discussion_agent "$mr_json" "$discussion_json" || return 1
  case $DISCUSSION_DISPOSITION in
    fixed)
      commit_generated_repair "$source_branch" "$expected_sha" "$project_id" \
        "fix(review): resolve MR feedback" || return 1
      reply_and_resolve_discussion "$discussion_id" "$DISCUSSION_REPLY" "$LAST_MR_SHA"
      ;;
    invalid|obsolete)
      [ -z "$(git status --porcelain --untracked-files=normal)" ] || return 1
      reply_and_resolve_discussion "$discussion_id" "$DISCUSSION_REPLY" "$expected_sha"
      ;;
    blocked) return 2 ;;
    *) return 1 ;;
  esac
}

merge_mr() {
  expected_sha=$1
  latest_mr=$(fetch_mr) || die "Unable to refresh MR before merge"
  mr_is_mergeable "$latest_mr" "$expected_sha" || die "MR is no longer mergeable"
  latest_pipelines=$(fetch_pipelines) || die "Unable to refresh pipeline before merge"
  latest_pipeline=$(printf '%s' "$latest_pipelines" | pipeline_for_sha "$expected_sha")
  [ "$(printf '%s' "$latest_pipeline" | jq -r '.status // "missing"')" = success ] || die "Latest MR SHA no longer has a successful pipeline"
  run_with_timeout "$COMMAND_TIMEOUT" glab mr merge "$MR_IID" --repo "$MR_PROJECT" --sha "$expected_sha" --auto-merge=false --yes || die "GitLab rejected the merge"
}

print_summary() {
  status=$1
  printf '\nMR loop %s\n' "$status"
  printf 'MR: %s\n' "$MR_URL"
  printf 'MR SHA: %s\n' "${LAST_MR_SHA:-unknown}"
  printf 'Pipeline SHA: %s\n' "${LAST_PIPELINE_SHA:-unknown}"
  printf 'Pipeline status: %s\n' "$LAST_PIPELINE_STATUS"
  printf 'Merge status: %s\n' "$LAST_MERGE_STATUS"
  printf 'Repair pushes: %s/%s\n' "$REPAIRS" "$MAX_REPAIRS"
  [ -z "$LAST_FAILED_JOBS" ] || printf 'Last failed jobs: %s\n' "$LAST_FAILED_JOBS"
  [ -z "$STOP_REASON" ] || printf 'Reason: %s\n' "$STOP_REASON"
  if [ -n "$REPO_ROOT" ] && [ -d "$REPO_ROOT" ]; then
    printf 'Local changes: %s\n' "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=normal | wc -l | tr -d ' ')"
  fi
}

monitor() {
  started=$(date +%s)
  while :; do
    now=$(date +%s)
    [ $((now - started)) -lt "$MAX_RUNTIME" ] || die "Wall-clock timeout reached"
    mr_json=$(fetch_mr) || die "Unable to fetch MR state"
    LAST_MR_SHA=$(printf '%s' "$mr_json" | jq -r .sha)
    LAST_MERGE_STATUS=$(printf '%s' "$mr_json" | jq -r .detailed_merge_status)
    source_branch=$(printf '%s' "$mr_json" | jq -r .source_branch)
    assert_unchanged_head "$source_branch" "$EXPECTED_LOCAL_SHA" || die "Current branch or HEAD changed unexpectedly"
    [ -z "$(git status --porcelain --untracked-files=normal)" ] || die "Working tree changed outside the repair agent"
    case $(rebase_action "$mr_json") in
      ready) ;;
      request)
        project_id=$(printf '%s' "$mr_json" | jq -r .target_project_id)
        request_gitlab_rebase "$LAST_MR_SHA" "$source_branch" "$project_id" || \
          die "GitLab rebase failed or did not converge"
        continue
        ;;
      wait)
        log "GitLab rebase is in progress; waiting ${POLL_INTERVAL}s"
        wait_for_gitlab_rebase "$LAST_MR_SHA" "$source_branch" || \
          die "GitLab rebase failed or did not converge"
        continue
        ;;
      error) die "GitLab rebase reported an error" ;;
    esac
    discussions=$(fetch_discussions) || die "Unable to fetch MR discussions"
    discussion=$(printf '%s' "$discussions" | next_unresolved_discussion)
    if [ "$discussion" != null ]; then
      project_id=$(printf '%s' "$mr_json" | jq -r .target_project_id)
      process_discussion "$mr_json" "$discussion" "$source_branch" "$project_id"
      discussion_status=$?
      [ "$discussion_status" -eq 0 ] || {
        [ "$discussion_status" -eq 2 ] && die "Discussion repair requires human intervention"
        die "Unable to repair and resolve discussion"
      }
      continue
    fi
    pipelines=$(fetch_pipelines) || die "Unable to fetch MR pipelines"
    pipeline=$(printf '%s' "$pipelines" | pipeline_for_sha "$LAST_MR_SHA")
    if [ "$pipeline" = null ]; then
      LAST_PIPELINE_STATUS=missing
      log "No pipeline for $LAST_MR_SHA; waiting ${POLL_INTERVAL}s"
      sleep "$POLL_INTERVAL"
      continue
    fi
    LAST_PIPELINE_SHA=$(printf '%s' "$pipeline" | jq -r .sha)
    LAST_PIPELINE_STATUS=$(printf '%s' "$pipeline" | jq -r .status)
    case $(pipeline_action "$LAST_PIPELINE_STATUS") in
      wait)
        log "Pipeline $LAST_PIPELINE_STATUS; waiting ${POLL_INTERVAL}s"
        sleep "$POLL_INTERVAL"
        ;;
      check-merge)
        if mr_is_mergeable "$mr_json" "$LAST_MR_SHA"; then
          if [ "$ON_SUCCESS" = merge ]; then
            merge_mr "$LAST_MR_SHA" || return 1
            print_summary merged
          else
            print_summary ready
          fi
          return 0
        fi
        if [ "$(merge_status_action "$LAST_MERGE_STATUS")" = wait ]; then
          log "Pipeline passed; merge status $LAST_MERGE_STATUS, waiting ${POLL_INTERVAL}s"
          sleep "$POLL_INTERVAL"
          continue
        fi
        die "Pipeline passed but GitLab merge checks are not satisfied"
        ;;
      repair)
        repair_allowed "$REPAIRS" "$MAX_REPAIRS" || die "Repair push limit reached"
        expected_sha=$LAST_MR_SHA
        expected_branch=$source_branch
        project_id=$(printf '%s' "$mr_json" | jq -r .target_project_id)
        latest_mr=$(fetch_mr) || die "Unable to refresh MR before repair"
        mr_matches_expected "$latest_mr" "$expected_sha" "$expected_branch" "$project_id" || die "MR identity changed before repair"
        latest_pipelines=$(fetch_pipelines) || die "Unable to refresh pipeline before repair"
        latest_pipeline=$(printf '%s' "$latest_pipelines" | pipeline_for_sha "$expected_sha")
        [ "$(pipeline_action "$(printf '%s' "$latest_pipeline" | jq -r '.status // "missing"')")" = repair ] || die "Failed pipeline changed before repair"
        assert_unchanged_head "$expected_branch" "$expected_sha" || die "Local HEAD changed before repair"
        [ -z "$(git status --porcelain --untracked-files=normal)" ] || die "Working tree changed before repair"
        run_repair_agent "$latest_mr" "$latest_pipeline" || die "Repair agent failed"
        assert_unchanged_head "$expected_branch" "$expected_sha" || die "Repair agent changed branch or HEAD"
        commit_and_push "$source_branch" "$expected_sha" "$project_id" || return 1
        ;;
      stop)
        die "Pipeline state '$LAST_PIPELINE_STATUS' requires human intervention"
        ;;
    esac
  done
}

main() {
  parse_args "$@" || return $?
  require_commands || return 1
  validate_repository || return 1
  auth_check || return 1
  acquire_lock || return 1
  trap 'STOP_REASON="Interrupted"; print_summary stopped; cleanup; exit 130' INT TERM HUP
  trap 'cleanup' EXIT
  mr_json=$(fetch_mr) || die "Unable to fetch MR" || return 1
  [ "$(printf '%s' "$mr_json" | jq -r .state)" = opened ] || die "MR is not open" || return 1
  checkout_mr_branch "$mr_json" || return 1
  monitor
  result=$?
  [ "$result" -eq 0 ] || print_summary stopped
  return "$result"
}

if [ "$PROGRAM" = mr-loop ]; then
  main "$@"
fi
