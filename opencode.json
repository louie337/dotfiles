{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"external_directory": {
			"~/.local/share/nvim/*": "allow"
		},
		"bash": {
			"~/.local/share/nvim/*": "ask"
		},
		"edit": {
			"~/.local/share/nvim/*": "ask"
		}
	},
	"mcp": {
		"linear": {
			"type": "remote",
			"url": "https://mcp.linear.app/mcp",
			"enabled": true
		}
	}
}
