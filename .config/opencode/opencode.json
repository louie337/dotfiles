{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": true
  },
  "instructions": [
    "PRIVATE.md"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--auto-connect"
      ],
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "artifact-drop": {
      "type": "local",
      "command": [
        "node",
        "/Users/louie/Documents/subanana/artifact-drop/server.mjs"
      ],
      "enabled": true,
      "env": {
        "ARTIFACT_DROP_TOKEN": "{env:ARTIFACT_DROP_TOKEN}"
      }
    }
  },
  "permission": {
    "bash": {
      "sudo *": "deny",
      "su *": "deny",
      "dd": "deny",
      "chmod 777": "deny",
      "rm *": "deny",
      "kubectl *": "deny",
      "tofu *": "deny"
    }
  },
  "agent": {
    "build": {
      "model": "datax_openai/gpt-5.6-sol",
      "variant": "max"
    },
    "plan": {
      "model": "datax_openai/gpt-5.6-sol",
      "variant": "max",
      "color": "#FF6B6B",
      "permission": {
        "edit": "deny"
      }
    },
    "teach": {
      "model": "datax_openai/gpt-5.6-terra",
      "variant": "low",
      "color": "#2FACED",
      "permission": {
        "edit": "deny"
      }
    },
    "patch": {
      "model": "datax_openai/gpt-5.6-terra",
      "variant": "low",
      "color": "#FFD966"
    }
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 60000,
        "timeout": 600000
      }
    },
    "datax_openai": {
      "name": "Datax OpenAI",
      "options": {
        "baseURL": "https://sg.datax.io/v1",
        "apiKey": "{env:DATAX_OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" },
            "ultra": { "reasoningEffort": "ultra" }
          },
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          },
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-terra": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" },
            "ultra": { "reasoningEffort": "ultra" }
          },
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          },
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-luna": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          },
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.5": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          },
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          },
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.4-mini": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          },
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          },
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "small_model": "datax_openai/gpt-5.4-mini"
}
